# Скопируй в apps/web/.env и подставь значения из Supabase:
# Project Settings → API. Оба значения публичные.
# Без них сайт собирается, но вместо данных показывает сообщение «Supabase не подключён».
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
