  <g stroke="var(--axo-accent)" stroke-width="5" stroke-linecap="round">
    <path d="M14 26 5 16M12 34 2 32M15 42 6 49"></path>
    <path d="M50 26l9-10M52 34l10-2M49 42l9 7"></path>
  </g>
  <rect x="12" y="16" width="40" height="36" rx="18" fill="var(--axo-accent-strong)"></rect>
  <circle cx="24" cy="32" r="3.5" fill="var(--axo-accent-contrast)"></circle>
  <circle cx="40" cy="32" r="3.5" fill="var(--axo-accent-contrast)"></circle>
  <path
    d="M26 41q6 5 12 0"
