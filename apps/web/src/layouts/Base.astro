---
import '@axo/ui/tokens.css';
import '@axo/ui/base.css';
import ServiceStatus from '@axo/ui/components/ServiceStatus.svelte';
import UserMenu from '@axo/ui/components/UserMenu.svelte';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  /** Служебные страницы (вход, аккаунт, админка) в поиске не нужны. */
  noindex?: boolean;
}

const SITE_NAME = 'Axo-Team';
const DEFAULT_DESCRIPTION =
  'Проекты Axo-Team: моды для Minecraft, игра для Roblox и Android-приложение.';

const { title, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/', label: 'Главная' },
  { href: '/projects/', label: 'Проекты' },
  { href: '/bugs/', label: 'Баг-репорты' },
  { href: '/status/', label: 'Состояние' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/projects/' && path.startsWith('/project/'));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0d1017" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <Logo />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Основная навигация">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-header__account">
          <UserMenu client:load />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {year} {SITE_NAME}</p>
        <div class="site-footer__meta">
          <ServiceStatus client:idle />
          <a href="https://github.com/GoShadowS" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--axo-bg);
    border-bottom: 1px solid var(--axo-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    min-height: 3.75rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--axo-text);
    font-weight: 700;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    color: var(--axo-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--axo-text);
  }

  nav a[aria-current='page'] {
    background: var(--axo-surface-raised);
    color: var(--axo-text);
  }

  .site-header__account {
    margin-left: auto;
  }

  main {
    flex: 1;
  }

  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--axo-border);
    color: var(--axo-muted);
    font-size: 0.875rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.25rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
</style>
