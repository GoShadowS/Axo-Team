---
import { ProjectCard } from '@axo/ui';
import Base from '../layouts/Base.astro';
import { getProjects, projectHref, toSummary } from '../lib/projects';

const projects = await getProjects();

const upcoming = [
  {
    title: 'Аккаунты',
    text: 'Регистрация и вход, чтобы оставлять комментарии и сообщать об ошибках.',
  },
  {
    title: 'Комментарии и баг-репорты',
    text: 'Обсуждение каждого проекта и понятный статус по каждой найденной ошибке.',
  },
  {
    title: 'Приложение для Windows',
    text: 'Тот же каталог и документация в виде программы, которая открывается и без интернета.',
  },
];
---

<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Портфолио</p>
      <h1>Axo-Team</h1>
      <p class="lead">
        Здесь собраны мои проекты: моды для Minecraft, игра для Roblox и Android-приложение. У каждого
        есть описание, документация и ссылки на исходный код.
      </p>
      <div class="hero__actions">
        <a class="button" href="/projects/">Смотреть проекты</a>
        <a class="button button--ghost" href="https://github.com/GoShadowS" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <h2 id="projects-title">Проекты</h2>
        <a href="/projects/">Весь каталог</a>
      </div>
      <ul class="grid">
        {
          projects.map((entry) => (
            <li>
              <ProjectCard project={toSummary(entry)} href={projectHref(entry)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="upcoming-title">
    <div class="container">
      <div class="section-head">
        <h2 id="upcoming-title">Что появится дальше</h2>
      </div>
      <ul class="upcoming">
        {
          upcoming.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 4.5rem 2.5rem;
    background:
      radial-gradient(40rem 20rem at 15% -10%, color-mix(in srgb, var(--axo-accent) 18%, transparent), transparent),
      radial-gradient(36rem 18rem at 95% 0%, color-mix(in srgb, var(--axo-teal) 14%, transparent), transparent);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--axo-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.02em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .upcoming {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .upcoming li {
    padding: 1.25rem;
    border: 1px dashed var(--axo-border);
    border-radius: var(--axo-radius);
  }

  .upcoming h3 {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
  }

  .upcoming p {
    margin: 0;
    color: var(--axo-muted);
  }
</style>
