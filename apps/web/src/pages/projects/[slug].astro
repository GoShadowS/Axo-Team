---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { PROJECT_STATUS_LABEL } from '@axo/ui';
import Base from '../../layouts/Base.astro';
import { getProjects, type ProjectEntry } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const { title, summary, kind, status, stack, license, links } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <article class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/projects/">Проекты</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="head">
        <p class="kind">{kind}</p>
        <h1>{title}</h1>
        <p class="lead">{summary}</p>
      </header>

      <div class="layout">
        <div class="prose">
          <Content />
        </div>

        <aside class="facts" aria-label="Сведения о проекте">
          <dl>
            <div>
              <dt>Состояние</dt>
              <dd>{PROJECT_STATUS_LABEL[status]}</dd>
            </div>
            {
              stack.length > 0 && (
                <div>
                  <dt>Технологии</dt>
                  <dd>{stack.join(', ')}</dd>
                </div>
              )
            }
            {
              license && (
                <div>
                  <dt>Лицензия</dt>
                  <dd>{license}</dd>
                </div>
              )
            }
          </dl>

          {
            links.length > 0 && (
              <ul class="links">
                {links.map((link) => (
                  <li>
                    <a class="button button--ghost" href={link.url} rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--axo-muted);
    font-size: 0.875rem;
  }

  .kind {
    margin: 0 0 0.375rem;
    color: var(--axo-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.01em;
  }

  .head .lead {
    margin: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 2.5rem;
    align-items: start;
    margin-top: 2rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .facts {
    position: sticky;
    top: 5rem;
    padding: 1.25rem;
    background: var(--axo-surface);
    border: 1px solid var(--axo-border);
    border-radius: var(--axo-radius);
  }

  dl {
    display: grid;
    gap: 0.875rem;
    margin: 0;
  }

  dt {
    color: var(--axo-muted);
    font-size: 0.8125rem;
  }

  dd {
    margin: 0.125rem 0 0;
  }

  .links {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links .button {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 48rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .facts {
      position: static;
      order: -1;
    }
  }
</style>
