{
  "name": "@axo/ui",
  "private": true,
  "version": "0.2.0",
  "description": "Общий интерфейс, аккаунты и доступ к данным для сайта и ПК-приложения",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
