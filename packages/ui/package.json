  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.43.6"
  },
  "devDependencies": {
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
